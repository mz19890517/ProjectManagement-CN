<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>ProjectManagement</RootNamespace>
    <AssemblyName>项目管理</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <Version>3.1.0</Version>
    <Product>易能测试项目管理</Product>
    <Authors>孟国胜</Authors>
    <Description>测试项目文件夹管理工具（原易语言 项目管理 v3.1 的 C# 移植版）</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Templates\*.bin">
      <LogicalName>NTpl_%(Filename)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.38.0" />
  </ItemGroup>

</Project>
